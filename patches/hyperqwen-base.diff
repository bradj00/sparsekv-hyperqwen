index d2ef229..106953f 100755
--- a/patches/apply.sh
+++ b/patches/apply.sh
@@ -11,6 +11,14 @@
 #                                     (site-packages/vllm, not site-packages)
 #   bash patches/apply.sh --kvarn DIR apply the four KVarN patches in kvarn/ to DIR, after
 #                                     the series (kvarn/install.sh calls this; so does CI)
+#   bash patches/apply.sh --sparse DIR
+#                                     apply only the sparse-KV entries of the series (the
+#                                     sparse-*.patch names, in series order) to DIR, a vllm
+#                                     tree that already has the rest of the series; idempotent
+#                                     like --kvarn (sparsekv/install.sh calls this). A fresh
+#                                     install gets them from the plain DIR mode, because they
+#                                     are in patches/series; every sparse patch is inert unless
+#                                     its SPARSE_* environment knob is set.
 #
 # Exit codes: 0 success; 1 a patch did not apply (the message names it); 2 a usage error,
 # or a list and its directory disagree (patches/series and patches/, or KVARN and kvarn/).
@@ -54,7 +62,7 @@ KVARN=(kvarn-0.31.0.patch kvarn-v2-runner-0.31.0.patch kvarn-recycled-pages-0.31
        kvarn-fp16-dequant-0.31.0.patch)
 
 usage() {
-  echo "usage: bash patches/apply.sh --list [--kvarn] | [--kvarn] DIR  (DIR = the installed vllm package directory)" >&2
+  echo "usage: bash patches/apply.sh --list [--kvarn] | [--kvarn|--sparse] DIR  (DIR = the installed vllm package directory)" >&2
   exit 2
 }
 
@@ -135,12 +143,31 @@ apply_kvarn() {
   done
 }
 
+# The sparse-KV entries of the series (sparse-*.patch), applied idempotently to a tree that
+# already carries the rest of the series: same reverse-dry-run check as --kvarn.
+apply_sparse() {
+  local dir=$1 names name n=0
+  [ -d "$dir" ] || { echo "ERROR: $dir is not a directory" >&2; usage; }
+  names=$(list) || exit 2
+  while IFS= read -r name; do
+    case "$name" in sparse-*.patch) ;; *) continue ;; esac
+    n=$((n + 1))
+    if patch -p1 -R --dry-run -s --fuzz 0 -d "$dir" -i "$HERE/$name" >/dev/null 2>&1; then
+      echo "== $name (already applied)"
+      continue
+    fi
+    apply_one "$dir" "$HERE/$name" "$name" "$SERIES_HINT"
+  done <<<"$names"
+  [ "$n" -gt 0 ] || { echo "ERROR: patches/series has no sparse-*.patch entries" >&2; exit 2; }
+}
+
 case "${1:-}" in
   --list)
     if [ $# -eq 1 ]; then list
     elif [ $# -eq 2 ] && [ "$2" = --kvarn ]; then list_kvarn
     else usage; fi ;;
   --kvarn) [ $# -eq 2 ] || usage; apply_kvarn "$2" ;;
+  --sparse) [ $# -eq 2 ] || usage; apply_sparse "$2" ;;
   ""|-*) usage ;;
   *) [ $# -eq 1 ] || usage; apply_series "$1" ;;
 esac
