+// ------------------------------------------------- flat GQA rows (E1, sparsekv-hyperqwen v1.1)
+// PTHFA_FLAT_GQA=1, prefill launches only (attn_launch.cu decides). The rows of
+// request r are the flat (token, head) pairs f = tok * G + h, f < q_len * G,
+// cut every kFlatRows rows: tile x of r covers flat rows
+// [64 (x - first), 64 (x - first) + 64). No padding rows except in the
+// request's last tile, so G = 6 fills 64 of 64 MMA rows instead of 60.
+// Request r owns tiles [floor(qsl[r] G / 64) + r, floor(qsl[r+1] G / 64) + r
+// + 1): >= ceil(q_len G / 64) tiles (same argument as first_q_tile), and the
+// last request ends at floor(T G / 64) + R, the flat grid.x.
+// A tile's first row may be in the middle of a token: row_off = row_begin %
+// G is the head of its first row, and CTA row r is the request-local flat row
+// tok_begin * G + row_off + r, i.e. row_to_token_head(r + row_off, ...). Every
+// real row keeps its own causal limit (from its own token), so each row's
+// arithmetic is the padded kernel's.
+constexpr int32_t kFlatRows = 64;
+
+PTH_HD int32_t first_q_tile_flat(const int32_t* query_start_loc, int32_t group,
+                                 int32_t r) {
+  return static_cast<int32_t>(static_cast<int64_t>(query_start_loc[r]) * group /
+                              kFlatRows) +
+         r;
+}
+
+PTH_HD int32_t find_request_flat(const int32_t* query_start_loc, int32_t group,
+                                 int32_t num_reqs, int32_t x) {
+  int32_t lo = 0, hi = num_reqs - 1;
+  while (lo < hi) {
+    const int32_t mid = lo + (hi - lo + 1) / 2;
+    if (first_q_tile_flat(query_start_loc, group, mid) <= x) {
+      lo = mid;
+    } else {
+      hi = mid - 1;
+    }
+  }
+  return lo;
+}
+
+// Fills `t` and `row_off` for flat q-tile x; false if the tile holds no row.
+// t.tok_begin is the token of the tile's first row, t.num_tok the tokens the
+// tile touches (partially at both ends), so kv_range_end / kv_min_limit keep
+// their meaning (last / first row's token).
+PTH_HD bool row_tile_flat(const int32_t* query_start_loc,
+                          const int32_t* seq_lens, const FastDivmod& group,
+                          int32_t num_reqs, int32_t x, RowTile& t,
+                          int32_t& row_off) {
+  if (num_reqs <= 0) return false;
+  const int32_t g = static_cast<int32_t>(group.divisor);
+  const int32_t r = find_request_flat(query_start_loc, g, num_reqs, x);
+  t.req = r;
+  t.q_start = query_start_loc[r];
+  t.q_len = query_start_loc[r + 1] - t.q_start;
+  t.seq_len = seq_lens[r];
+  const int64_t rows = static_cast<int64_t>(t.q_len) * g;
+  const int64_t begin =
+      static_cast<int64_t>(x - first_q_tile_flat(query_start_loc, g, r)) *
+      kFlatRows;
+  if (begin >= rows) return false;
+  const int64_t last = begin + kFlatRows - 1 < rows ? begin + kFlatRows - 1
+                                                    : rows - 1;
+  uint32_t tb = 0, off = 0;
+  group.divmod(static_cast<uint32_t>(begin), tb, off);
+  t.tok_begin = static_cast<int32_t>(tb);
+  row_off = static_cast<int32_t>(off);
+  t.num_tok = static_cast<int32_t>(group.div(static_cast<uint32_t>(last))) -
+              t.tok_begin + 1;
+  return true;
+}
+
