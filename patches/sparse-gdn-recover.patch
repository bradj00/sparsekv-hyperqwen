--- a/model_executor/layers/mamba/gdn/recover.py	1970-01-01 00:00:00.000000000 +0000
+++ b/model_executor/layers/mamba/gdn/recover.py	2026-11-11 09:39:53.899028249 +0000
@@ -0,0 +1,200 @@
+# SPDX-License-Identifier: Apache-2.0
+"""GDN speculative decode without per-draft-token state blocks (SPARSE_GDN_RECOVER=1, sparsekv s13).
+
+Baseline (align mode + MTP/EAGLE, K draft tokens): the verify step runs K+1 tokens through every GDN layer and
+stores the recurrent state after EACH token in its own block (block-table columns c, c+1, ..., c+K; c = the running
+block), because the accepted count is only known after sampling; the next step starts from column
+num_accepted - 1. Every resident request therefore holds K extra state blocks per mamba group for its whole life
+(Qwen3.x 27B, K=7, 3 groups: 21 of the 27 blocks a request pins; on a 112-block pool that is 3-4 residents).
+
+Recover mode keeps ONE state block per group (num_speculative_blocks = 0):
+  * verify forward: the kernel reads the running block and stores NO state; the per-token gate/key/value inputs of
+    the window are kept in a small per-layer buffer (K+1 tokens per request);
+  * postprocess (accepted count n known, still on the GPU): ``commit`` replays tokens 0..n-1 of the window onto the
+    running block with the same recurrence, so the running block always holds the state of the accepted prefix. When
+    the accepted tokens cross a block boundary it also writes the block-aligned checkpoint the align cache keeps.
+The convolution state never used the extra blocks (one sliding window in the running block, shifted by
+num_accepted - 1), so it is untouched and still reads num_accepted.
+
+Numerics: bit-identical to the baseline. Both start from the stored running state, carry the window in fp32 with the
+same operations in the same order, and round to the cache dtype once, at the accepted token.
+"""
+import os
+
+import torch
+
+from vllm.triton_utils import tl, triton
+
+_ENABLED = os.environ.get("SPARSE_GDN_RECOVER", "0") == "1"
+_BUILDERS: list = []
+STATS = {"commits": 0, "layers": 0}
+
+
+def enabled() -> bool:
+    return _ENABLED
+
+
+def register_builder(builder) -> None:
+    if builder not in _BUILDERS:
+        _BUILDERS.append(builder)
+
+
+def clear() -> None:
+    for b in _BUILDERS:
+        b._recover_step = None
+
+
+@triton.jit(do_not_specialize=["N"])
+def gdn_recover_commit_kernel(
+    A_log,
+    a,
+    b,
+    dt_bias,
+    k,
+    v,
+    h,
+    tok_start,  # int32 [N + 1] first window token of each spec row (in the saved buffers)
+    n_apply,  # int32 [N] tokens 0..n_apply-1 of the window are applied (= accepted count); <= 0: nothing
+    run_blk,  # int32 [N] block id of the running state (<= 0: skip)
+    ckpt_at,  # int32 [N] write a checkpoint after this many applied tokens (< 1: none)
+    ckpt_blk,  # int32 [N] block id of that checkpoint
+    beta,
+    threshold,
+    N: tl.int64,
+    H: tl.constexpr,
+    HV: tl.constexpr,
+    K: tl.constexpr,
+    V: tl.constexpr,
+    BK: tl.constexpr,
+    BV: tl.constexpr,
+    stride_state: tl.constexpr,
+):
+    i_v, i_nh = tl.program_id(0), tl.program_id(1)
+    i_n, i_hv = i_nh // HV, i_nh % HV
+    i_h = i_hv // (HV // H)
+    napp = tl.load(n_apply + i_n).to(tl.int64)
+    if napp <= 0:
+        return
+    blk = tl.load(run_blk + i_n).to(tl.int64)
+    if blk <= 0:
+        return
+    bos = tl.load(tok_start + i_n).to(tl.int64)
+    width = tl.load(tok_start + i_n + 1).to(tl.int64) - bos
+    if napp > width:
+        napp = width
+    c_at = tl.load(ckpt_at + i_n).to(tl.int64)
+    c_blk = tl.load(ckpt_blk + i_n).to(tl.int64)
+
+    o_k = tl.arange(0, BK)
+    o_v = i_v * BV + tl.arange(0, BV)
+    mask_k = o_k < K
+    mask_v = o_v < V
+    mask_h = mask_v[:, None] & mask_k[None, :]
+
+    p_k = k + (bos * H + i_h) * K + o_k
+    p_v = v + (bos * HV + i_hv) * V + o_v
+    p_a = a + bos * HV + i_hv
+    p_b = b + bos * HV + i_hv
+    off_h = i_hv * V * K + o_v[:, None] * K + o_k[None, :]
+    p_h = h + blk * stride_state + off_h
+    b_h = tl.load(p_h, mask=mask_h, other=0).to(tl.float32)
+    g_scale = -tl.exp(tl.load(A_log + i_hv).to(tl.float32))
+    dtb = tl.load(dt_bias + i_hv).to(tl.float32)
+
+    for i_t in range(0, napp):
+        b_k = tl.load(p_k, mask=mask_k, other=0).to(tl.float32)
+        b_v = tl.load(p_v, mask=mask_v, other=0).to(tl.float32)
+        x = tl.load(p_a).to(tl.float32) + dtb
+        softplus_x = tl.where(beta * x <= threshold, (1 / beta) * tl.log(1 + tl.exp(beta * x)), x)
+        b_g = g_scale * softplus_x
+        b_beta = tl.sigmoid(tl.load(p_b).to(tl.float32))
+        b_k = b_k * (tl.rsqrt(tl.sum(b_k * b_k) + 1e-6))
+        b_h *= tl.exp(b_g)
+        b_v -= tl.sum(b_h * b_k[None, :], 1)
+        b_v *= b_beta
+        b_h += b_v[:, None] * b_k[None, :]
+        if (i_t + 1 == c_at) & (c_blk > 0):
+            tl.store(h + c_blk * stride_state + off_h, b_h.to(h.dtype.element_ty), mask=mask_h)
+        p_k += H * K
+        p_v += HV * V
+        p_a += HV
+        p_b += HV
+    tl.store(p_h, b_h.to(h.dtype.element_ty), mask=mask_h)
+
+
+def attach(layer, max_tokens: int, hv: int, h: int, kdim: int, vdim: int, dtype) -> None:
+    """Per GDN layer: buffers for the gate/key/value inputs of the current verify window (spec-token order).
+    Registered as non-persistent module buffers so they move to the GPU with the weights and are part of the
+    model's memory before vLLM profiles what is left for the KV cache (48 layers x 1.5 MB at 11 x 8 tokens)."""
+    layer.register_buffer("_gdn_rec_a", torch.zeros((max_tokens, hv), dtype=dtype), persistent=False)
+    layer.register_buffer("_gdn_rec_b", torch.zeros((max_tokens, hv), dtype=dtype), persistent=False)
+    layer.register_buffer("_gdn_rec_k", torch.zeros((max_tokens, h, kdim), dtype=dtype), persistent=False)
+    layer.register_buffer("_gdn_rec_v", torch.zeros((max_tokens, hv, vdim), dtype=dtype), persistent=False)
+
+
+def save(layer, a: torch.Tensor, b: torch.Tensor, k: torch.Tensor, v: torch.Tensor) -> None:
+    """a, b: [T, HV]; k: [1, T, H, K]; v: [1, T, HV, V] (the spec rows of this step)."""
+    t = a.shape[0]
+    layer._gdn_rec_a[:t].copy_(a)
+    layer._gdn_rec_b[:t].copy_(b)
+    layer._gdn_rec_k[:t].copy_(k[0])
+    layer._gdn_rec_v[:t].copy_(v[0])
+
+
+def commit(
+    num_sampled,
+    idx_mapping: torch.Tensor,
+    state_idx: torch.Tensor,
+    num_computed_tokens: torch.Tensor | None,
+    static_forward_context: dict,
+    block_size: int,
+) -> None:
+    """After sampling: bring every spec row's running GDN state to its accepted prefix (see the module docstring).
+    num_sampled / idx_mapping are batch-ordered; state_idx / num_computed_tokens are per request slot
+    (num_computed_tokens already holds the post-step count)."""
+    for builder in _BUILDERS:
+        step = builder._recover_step
+        builder._recover_step = None
+        if step is None or isinstance(num_sampled, int) or num_computed_tokens is None:
+            continue
+        rows, tok_start, run_blk, block_table = step
+        nspec = rows.shape[0]
+        if nspec == 0:
+            continue
+        req = idx_mapping[rows].long()
+        valid = req >= 0
+        req = req.clamp(min=0)
+        n = num_sampled[rows].to(torch.int64).clamp(min=1)
+        new = num_computed_tokens[req].to(torch.int64)
+        col = state_idx[req].to(torch.int64)
+        running = new - n + 1  # tokens covered by the state after window token 0
+        aligned = (new // block_size) * block_size
+        bias = aligned - running
+        dest = aligned // block_size - 1
+        need = valid & (aligned >= running) & (dest != col) & (dest >= 0)
+        ckpt_at = torch.where(need, bias + 1, torch.full_like(bias, -1)).to(torch.int32)
+        dest_c = dest.clamp(0, block_table.shape[1] - 1)
+        ckpt_blk = torch.where(need, block_table[rows, dest_c].to(torch.int64),
+                               torch.zeros_like(dest)).to(torch.int32)
+        n_apply = torch.where(valid, n, torch.zeros_like(n)).to(torch.int32)
+        run_blk = run_blk[:nspec].contiguous()
+        tok_start = tok_start[: nspec + 1].contiguous()
+        STATS["commits"] += 1
+        for name in builder.layer_names:
+            layer = static_forward_context[name]
+            ra = getattr(layer, "_gdn_rec_a", None)
+            if ra is None:
+                continue
+            rk, rv = layer._gdn_rec_k, layer._gdn_rec_v
+            h = layer.kv_cache[1]
+            hv, kdim, vdim = ra.shape[1], rk.shape[2], rv.shape[2]
+            bk, bv = triton.next_power_of_2(kdim), min(triton.next_power_of_2(vdim), 32)
+            gdn_recover_commit_kernel[(triton.cdiv(vdim, bv), nspec * hv)](
+                layer.A_log, ra, layer._gdn_rec_b, layer.dt_bias, rk, rv, h,
+                tok_start, n_apply, run_blk, ckpt_at, ckpt_blk,
+                1.0, 20.0,
+                N=nspec, H=rk.shape[1], HV=hv, K=kdim, V=vdim, BK=bk, BV=bv,
+                stride_state=h.stride(0),
+                num_warps=4,
+            )
+            STATS["layers"] += 1
